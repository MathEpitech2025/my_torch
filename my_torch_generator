#!/usr/bin/env python3
import sys
import os
import json
from typing import List, Tuple

sys.path.append(os.path.join(os.path.dirname(__file__), "src"))

from generator.generator import NetworkGenerator, NetworkConfig

def print_usage() -> None:
    print("Usage: ./my_torch_generator config_file_1 nb_1 [config_file_2 nb_2...]", file=sys.stderr)

def main() -> None:
    args = sys.argv[1:]
    
    if len(args) == 0 or len(args) % 2 != 0:
        print("Error: Invalid number of arguments.", file=sys.stderr)
        print_usage()
        sys.exit(84)
    jobs: List[Tuple[str, int]] = []
    try:
        for i in range(0, len(args), 2):
            config_file = args[i]
            count = int(args[i+1])
            if count <= 0:
                raise ValueError(f"Count must be positive (got {count})")
            jobs.append((config_file, count))
    except ValueError as e:
        print(f"Error parsing arguments: {e}", file=sys.stderr)
        sys.exit(84)

    for config_path, count in jobs:
        if not os.path.exists(config_path):
            print(f"Error: Config file not found: {config_path}", file=sys.stderr)
            sys.exit(84)
            
        try:
            with open(config_path, 'r') as f:
                raw_config = json.load(f)
        except json.JSONDecodeError as e:
            print(f"Error: Failed to parse JSON in {config_path}: {e}", file=sys.stderr)
            sys.exit(84)
        except Exception as e:
            print(f"Error reading file {config_path}: {e}", file=sys.stderr)
            sys.exit(84)
            
        try:
            config = NetworkConfig.from_dict(raw_config)
            print(f"Loaded config from {config_path}: Inputs={config.input_size} -> Layers={config.hidden_layers} -> Output={config.output_size}", file=sys.stdout)
        except Exception as e:
             print(f"Error validating config from {config_path}: {e}", file=sys.stderr)
             sys.exit(84)

        base_name = os.path.splitext(os.path.basename(config_path))[0]
        
        for i in range(count):
            try:
                model = NetworkGenerator.generate(config)
                output_filename = f"{base_name}_{i+1}.nn"
                
                NetworkGenerator.save_network(model, output_filename)
                
            except Exception as e:
                print(f"Error generating network {i+1} from {config_path}: {e}", file=sys.stderr)
                sys.exit(84)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"Unexpected error: {e}", file=sys.stderr)
        sys.exit(84)
